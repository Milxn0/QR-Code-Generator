{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install mini project dependencies",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build mini project frontend",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Build mini project API",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build:api"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Run mini project dev servers",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Check Docker availability",
			"type": "shell",
			"command": "docker",
			"args": [
				"--version"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Start PostgreSQL database",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"up",
				"-d",
				"db"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Audit production dependencies",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"audit",
				"--omit=dev"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Git status for GitHub push",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short",
				"--branch"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Git remote for GitHub push",
			"type": "shell",
			"command": "git",
			"args": [
				"remote",
				"-v"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Fetch GitHub before push",
			"type": "shell",
			"command": "git",
			"args": [
				"fetch",
				"origin"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check Git commit identity",
			"type": "shell",
			"command": "git",
			"args": [
				"config",
				"--get",
				"user.name"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check local environment ignore",
			"type": "shell",
			"command": "git",
			"args": [
				"check-ignore",
				".env"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check GitHub branch state",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short",
				"--branch"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check remote branch contents",
			"type": "shell",
			"command": "git",
			"args": [
				"ls-tree",
				"--name-only",
				"origin/main"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check commit email identity",
			"type": "shell",
			"command": "git",
			"args": [
				"config",
				"--get",
				"user.email"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stage mini project for GitHub",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"-A"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Review staged Git files",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Review staged change summary",
			"type": "shell",
			"command": "git",
			"args": [
				"diff",
				"--cached",
				"--stat"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify environment is not staged",
			"type": "shell",
			"command": "git",
			"args": [
				"diff",
				"--cached",
				"--name-only",
				"--",
				".env"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Exclude generated VS Code task file",
			"type": "shell",
			"command": "git",
			"args": [
				"restore",
				"--staged",
				"--",
				".vscode/tasks.json"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Confirm commit contents",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Confirm commit summary",
			"type": "shell",
			"command": "git",
			"args": [
				"diff",
				"--cached",
				"--stat"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}